<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_primary"
    android:fitsSystemWindows="true">

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/splashCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Plant Emoji Icon -->
        <TextView
            android:id="@+id/splashIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌱"
            android:textSize="90sp" />

        <!-- App Name -->
        <TextView
            android:id="@+id/splashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="Plant Care Reminder"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:text="Your smart plant reminder"
            android:textColor="#C8E6C9"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Loading dots at bottom center -->
    <LinearLayout
        android:id="@+id/splashLoader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●  ●  ●"
            android:textColor="#80FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Attribution at very bottom -->
    <TextView
        android:id="@+id/splashAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:text="Developed by Vikum Kalhara"
        android:textColor="#80FFFFFF"
        android:textSize="12sp" />

</RelativeLayout>
