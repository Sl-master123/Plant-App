<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Plant Image -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#DDECCF"
            android:gravity="center"
            android:text="🌿"
            android:textSize="80sp" />

        <!-- Plant Name -->

        <TextView
            android:id="@+id/tvDetailsPlantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Monstera"
            android:textColor="#1B1B1B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Date Planted -->

        <TextView
            android:id="@+id/tvDatePlanted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Planted on 12 August 2026"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Time Elapsed -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plant Age"
                android:textColor="#777777"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPlantAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="4 months old"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Next Watering -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Next Watering"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Countdown Placeholder -->

        <TextView
            android:id="@+id/tvWaterCountdown"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:background="#DDECCF"
            android:gravity="center"
            android:text="2 days"
            android:textColor="#31552A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNextWatering"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Next watering: 14 August"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Care Tip -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Care Tip"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCareTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Water your Monstera when the top few centimeters of soil become dry."
            android:textColor="#555555"
            android:textSize="15sp" />

        <!-- Watering History -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Watering History"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWateringHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="No watering history yet."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- Water Plant -->

        <Button
            android:id="@+id/btnWaterPlant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:text="💧  Water Plant"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>